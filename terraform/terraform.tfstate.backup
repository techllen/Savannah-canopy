              {
                "build_status_config": [],
                "buildspec": "#version: 0.2\r\n#\r\n#phases:\r\n#  install:\r\n#    commands:\r\n#      - echo Installing Maven...\r\n#      - mvn --version\r\n#  build:\r\n#    commands:\r\n#      - echo Building the Spring Boot app...\r\n#      - mvn -f savannah-canopy-rest/pom.xml clean package\r\n#      - ls savannah-canopy-rest/target\r\n#      - pwd\r\n#artifacts:\r\n#  files:\r\n#    - savannah-canopy-rest/target/*.jar\r\n\r\n\r\nversion: 0.2\r\n\r\n#setting up environmental variables\r\nenv:\r\n  variables:\r\n    AWS_ACCOUNT_ID: \"539247457480\"\r\n    AWS_DEFAULT_REGION: \"us-east-1\"\r\n\r\nphases:\r\n  install:\r\n    commands:\r\n      - echo Installing Maven...\r\n      - mvn --version\r\n  pre_build:\r\n    commands:\r\n      - echo Logging in to Amazon ECR...\r\n      - aws ecr get-login-password --region $AWS_DEFAULT_REGION | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com\r\n  build:\r\n    commands:\r\n      - echo Building the Spring Boot app...\r\n      - mvn -f savannah-canopy-rest/pom.xml clean package\r\n      - echo Building the Docker image...\r\n#      - docker build -f savannah-canopy-rest/Dockerfile -t $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-backend-registry:latest .\r\n      - docker build --load -f savannah-canopy-rest/Dockerfile -t $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-backend-registry:latest . #looks for docker file\r\n      - docker tag $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-backend-registry:latest $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-backend-registry:$CODEBUILD_RESOLVED_SOURCE_VERSION\r\n  post_build:\r\n    commands:\r\n      - echo Pushing the Docker image...\r\n      - docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-backend-registry:latest\r\n      - docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-backend-registry:$CODEBUILD_RESOLVED_SOURCE_VERSION\r\nartifacts:\r\n  files:\r\n    - savannah-canopy-rest/target/*.jar\r\n    - imagedefinitions-backend.json #provide information to CodePipeline (or other deployment tools) about where to fetch the image from ECR",
                "git_clone_depth": 0,
                "git_submodules_config": [],
                "insecure_ssl": false,
