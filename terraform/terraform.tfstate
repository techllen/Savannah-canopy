            "service_role": "arn:aws:iam::539247457480:role/codebuild-role",
            "source": [
              {
                "build_status_config": [],
                "buildspec": "#version: 0.2\r\n#\r\n#phases:\r\n#  install:\r\n#    commands:\r\n#      - echo Installing Node...\r\n#      - cd savannah-canopy-web\r\n#      - node --version\r\n#      - npm install\r\n#  build:\r\n#    commands:\r\n#      - echo Building the React app...\r\n#      - npm run build\r\n#artifacts:\r\n#  base-directory: savannah-canopy-web/build\r\n#  files:\r\n#    - '**/*'\r\n\r\n#version: 0.2\r\n#\r\n##setting up environmental variables\r\n#env:\r\n#  variables:\r\n#    AWS_ACCOUNT_ID: \"539247457480\"\r\n#    AWS_DEFAULT_REGION: \"us-east-1\"\r\n#\r\n#phases:\r\n#  install:\r\n#    commands:\r\n#      - echo Installing Node...\r\n#      - cd savannah-canopy-web\r\n#      - node --version\r\n#      - npm install\r\n#  pre_build:\r\n#    commands:\r\n#      - echo Logging in to Amazon ECR...\r\n#      - aws ecr get-login-password --region $AWS_DEFAULT_REGION | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com\r\n#  build:\r\n#    commands:\r\n#      - echo Building the React app...\r\n#      - npm run build\r\n#      - echo Building the Docker image...\r\n##      - docker build -t $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:latest . #looks for docker file\r\n#      - docker build -f Dockerfile -t $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:latest . #looks for docker file\r\n#      - docker tag $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:latest $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:$CODEBUILD_RESOLVED_SOURCE_VERSION\r\n#  post_build:\r\n#    commands:\r\n#      - echo Pushing the Docker image...\r\n#      - docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:latest\r\n#      - docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:$CODEBUILD_RESOLVED_SOURCE_VERSION\r\n#artifacts:\r\n#  base-directory: savannah-canopy-web/build\r\n#  files:\r\n#    - '**/*'\r\n#    - ../imagedefinitions-frontend.json #provide information to CodePipeline (or other deployment tools) about where to fetch the image from ECR\r\n\r\n\r\nversion: 0.2\r\n\r\nenv:\r\n  variables:\r\n    AWS_ACCOUNT_ID: \"539247457480\"\r\n    AWS_DEFAULT_REGION: \"us-east-1\"\r\n\r\nphases:\r\n  install:\r\n    commands:\r\n      - echo Installing Node...\r\n      - cd savannah-canopy-web\r\n      - node --version\r\n      - npm install\r\n  pre_build:\r\n    commands:\r\n      - echo Logging in to Amazon ECR...\r\n      - aws ecr get-login-password --region $AWS_DEFAULT_REGION | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com\r\n      - echo Logging in to Docker Hub...\r\n      - DOCKERHUB_TOKEN=$(aws secretsmanager get-secret-value --secret-id dockerhub-access-token --query SecretString --output text)\r\n      - docker login -u matopt -p \"$DOCKERHUB_TOKEN\"\r\n  build:\r\n    commands:\r\n      - echo Building the React app...\r\n      - npm run build\r\n      - echo Building the Docker image...\r\n      - docker build -f Dockerfile -t $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:latest .\r\n      - docker tag $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:latest $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:$CODEBUILD_RESOLVED_SOURCE_VERSION\r\n  post_build:\r\n    commands:\r\n      - echo Pushing the Docker image...\r\n      - docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:latest\r\n      - docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_DEFAULT_REGION.amazonaws.com/plantstore-frontend-registry:$CODEBUILD_RESOLVED_SOURCE_VERSION\r\n      - echo Moving image definitions to build directory...\r\n      - cd ../\r\n      - cp imagedefinitions-frontend.json savannah-canopy-web/build/\r\nartifacts:\r\n  base-directory: savannah-canopy-web/build\r\n  files:\r\n    - '**/*'",
                "git_clone_depth": 0,
                "git_submodules_config": [],
                "insecure_ssl": false,
                "location": "",
                "report_build_status": false,
                "type": "CODEPIPELINE"
              }
