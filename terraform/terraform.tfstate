            "output_base64sha256": "3Ise1xvxUCHrTA1FPdnkeknrkgJffO43ZcV2GVeAp7M=",
            "output_base64sha512": "kbJrAJwILCKLUwbV9xXRI0xxRr7h8BB5zyup+L3VP11u8/hL5pTTu+UVj0v9ve+7voGghQz5ISkRusLmT/7MxQ==",
            "output_file_mode": null,
            "output_md5": "bbaf70c098874b0c6be9249a738030dc",
            "output_path": "backend_lambda_function.zip",
            "output_sha": "d856c8c63c0127cc1b03dccdbab221043cb00d22",
            "output_sha256": "dc8b1ed71bf15021eb4c0d453dd9e47a49eb92025f7cee3765c576195780a7b3",
            "output_sha512": "91b26b009c082c228b5306d5f715d1234c7146bee1f01079cf2ba9f8bdd53f5d6ef3f84be694d3bbe5158f4bfdbdefbbbe81a0850cf9212911bac2e64ffeccc5",
            "output_size": 854,
            "source": [],
            "source_content": "import json\r\nimport boto3\r\nimport base64\r\nimport os\r\n\r\nbedrock_runtime = boto3.client(service_name='bedrock-runtime')\r\nmodel_id = os.environ['BEDROCK_MODEL_ID'] # get id from env variable\r\n\r\ndef lambda_handler(event, context):\r\n    # Ensure the `awslogs` key exists\r\n    if 'awslogs' not in event or 'data' not in event['awslogs']:\r\n        print(\"Invalid event format: Missing 'awslogs.data'\")\r\n        return {'statusCode': 400, 'body': 'Invalid event format'}\r\n\r\n    # Decode log data\r\n    data = base64.b64decode(event['awslogs']['data'])\r\n    log_data = json.loads(data)\r\n\r\n    for log_event in log_data.get('logEvents', []):\r\n        message = log_event.get('message', '')\r\n\r\n        if \"ERROR\" in message:\r\n            print(f\"Error message: {message}\")\r\n            try:\r\n\r\n                prompt = message\r\n\r\n                payload = {\r\n                    \"prompt\": f\"\u003cs\u003e[INST] {prompt} [/INST]\",\r\n                    \"max_tokens\": 500,\r\n                    \"temperature\": 0.5\r\n                }\r\n\r\n                response = bedrock_runtime.invoke_model(\r\n                    modelId=model_id,\r\n                    accept='application/json',\r\n                    contentType='application/json',\r\n                    body=json.dumps(payload),\r\n                )\r\n\r\n                response_body = json.loads(response['body'].read())\r\n                generated_text = response_body['outputs'][0]['text']\r\n                # print(f\"Bedrock response: {generated_text}\")\r\n\r\n            except Exception as e:\r\n                print(f\"Error invoking Bedrock: {e}\")\r\n\r\n    return {\r\n        'statusCode': 200,\r\n        'body': json.dumps({'generated_text': generated_text})\r\n    }\r\n",
            "source_content_filename": "lambda_function.py",
            "source_dir": null,
            "source_file": null,
            "type": "zip"
          },
          "sensitive_attributes": []
        }
      ]
    },
